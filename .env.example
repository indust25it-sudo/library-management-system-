# -------------------------------------------------------------
# LibraX Library Management System - Environment Configuration
# -------------------------------------------------------------
# Copy this file to .env and fill in the values for your deployment.
# NEVER commit the actual .env file with production secrets to source control.

# Application Server
PORT=3000
NODE_ENV=production

# Supabase PostgreSQL Configuration
# Retrieve these credentials from your Supabase Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key for Grounded Library Copilot
# Retrieve from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
